# =====================================================================
# Wazihood $WAZI Allocation Checker - Backend Configuration
# =====================================================================

# --- Network ---
# Robinhood Chain Mainnet. Only this chain's on-chain activity counts.
# Chain ID 4663 / Official RPC: https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_CHAIN_ID=4663
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Timeout for blockchain RPC calls in milliseconds.
ROBINHOOD_RPC_TIMEOUT_MS=20000

# --- Wazi NFT Collection (BONUS COLLECTION - not an eligibility requirement) ---
# Wazi NFT ownership is OPTIONAL. It never grants or removes eligibility; it
# only adds a bonus on top of the activity-based allocation. Leave empty until
# the real contract address is known - the API returns a clear config error
# instead of fabricating ownership.
WAZI_NFT_CONTRACT_ADDRESS=

# NFT standard. ERC721 is the initial implementation; ERC1155 is supported modularly.
WAZI_NFT_STANDARD=ERC721
# Only required when WAZI_NFT_STANDARD=ERC1155
WAZI_NFT_TOKEN_ID=

# --- Wazi NFT on OpenSea (bonus CTA) ---
# Full URL of the official Wazihood NFT collection on OpenSea. When set, the
# "GET A WAZI NFT" button opens this in a new tab. Leave empty to hide the link.
WAZI_OPENSEA_COLLECTION_URL=

# --- Blockchain Data (transaction history) ---
# Prefer Alchemy's official Robinhood Chain endpoint for production data.
# Keep credentials server-side. Never expose the key in frontend JS.
# Provide the FULL Alchemy endpoint, for example:
#   ALCHEMY_URL=https://robinhood-mainnet.g.alchemy.com/v2/MY_API_KEY
# OR set only ALCHEMY_API_KEY; the official URL is then built automatically:
ALCHEMY_API_KEY=
ALCHEMY_URL=

# --- Tokenomics ($WAZI) ---
TOTAL_WAZI_SUPPLY=1000000000
ALLOCATION_POOL=300000000
# $WAZI of the allocation pool already committed to holders. Fed forward so the
# persistent system caps new allocations to the remaining pool (pool never exceeded).
ALREADY_ALLOCATED=0

# --- Allocation Engine (deterministic, configurable) ---
# Per-wallet allocation bounds. Every eligible wallet receives at least
# MIN_ELIGIBLE_ALLOCATION and never more than MAX_ELIGIBLE_ALLOCATION.
MIN_ELIGIBLE_ALLOCATION=1
MAX_ELIGIBLE_ALLOCATION=100000
# $WAZI awarded to a wallet whose activity score reaches 100.
MAX_ACTIVITY_ALLOCATION=30000
# Monotonic score curve: { transactionCountThreshold: activityScore }
# More transactions can never produce a lower score/allocation.
ACTIVITY_SCORE_TIERS_JSON={"1":10,"5":25,"10":40,"25":55,"50":70,"100":80,"250":92,"500":100}
# Optional Wazi NFT holder bonus. When NFT_HOLDER_BONUS_ALLOCATION > 0 the flat
# amount is used; otherwise NFT_HOLDER_BONUS_PERCENT of the activity allocation
# is added. NFT ownership is never an eligibility requirement, only a bonus.
NFT_HOLDER_BONUS_ALLOCATION=0
NFT_HOLDER_BONUS_PERCENT=20

# --- Persistence ---
# sqlite is the built-in store: persistent on-disk, restart-safe, atomic
# get-or-create with a unique (wallet, network) constraint. Ideal for
# local development. For a production/Vercel deployment use postgres.
ALLOCATION_STORE=sqlite
ALLOCATION_DB_PATH=./data/allocations.sqlite

# Hosted PostgreSQL connection string. ONLY used when ALLOCATION_STORE=postgres.
# NEVER commit the real value. Use a hosted provider such as Neon; obtain the
# URL from your database dashboard and set it as a Vercel environment variable.
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# --- Server ---
PORT=3001
